# Embeds a URDF file as a C++ raw string literal.
#
# This is deliberately a pure text transformation: the URDF is parsed during
# constant evaluation in Algorithms/URDF, so nothing here needs to understand
# the URDF schema.
#
# Invoked with -DURDF_IN=<file> -DURDF_OUT=<header> -DURDF_SYMBOL=<name>
# Produces:  #define <name>_LITERAL R"URDF(...)URDF"

if (NOT DEFINED URDF_IN OR NOT DEFINED URDF_OUT OR NOT DEFINED URDF_SYMBOL)
    message(FATAL_ERROR "embed_urdf.cmake requires URDF_IN, URDF_OUT and URDF_SYMBOL")
endif ()

if (NOT EXISTS "${URDF_IN}")
    message(FATAL_ERROR "URDF not found: ${URDF_IN}")
endif ()
if (NOT URDF_SYMBOL MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "URDF_SYMBOL must be a C++ identifier: ${URDF_SYMBOL}")
endif ()
get_filename_component(URDF_OUT "${URDF_OUT}" ABSOLUTE)
get_filename_component(_output_dir "${URDF_OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_output_dir}")

file(READ "${URDF_IN}" _text)

# Normalise line endings so the embedded literal does not depend on the checkout.
string(REPLACE "\r\n" "\n" _text "${_text}")

# The literal terminates at )DELIM", so the delimiter must not occur in the text.
set(_delim "URDF")
set(_i 0)
while (_i LESS 32)
    string(FIND "${_text}" ")${_delim}\"" _hit)
    if (_hit EQUAL -1)
        break ()
    endif ()
    math(EXPR _i "${_i} + 1")
    set(_delim "URDF${_i}")
endwhile ()
if (_i GREATER_EQUAL 32)
    message(FATAL_ERROR "Could not find a safe raw string delimiter for ${URDF_IN}")
endif ()

string(LENGTH "${_text}" _bytes)
get_filename_component(_name "${URDF_IN}" NAME)

file(WRITE "${URDF_OUT}"
        "// Generated by cmake/embed_urdf.cmake -- do not edit.\n"
        "// Source: ${_name}  (${_bytes} bytes)\n"
        "#ifndef FINEMOTE_MODEL_${URDF_SYMBOL}_HPP\n"
        "#define FINEMOTE_MODEL_${URDF_SYMBOL}_HPP\n"
        "\n"
        "#define ${URDF_SYMBOL}_LITERAL R\"${_delim}(${_text})${_delim}\"\n"
        "\n"
        "#endif // FINEMOTE_MODEL_${URDF_SYMBOL}_HPP\n")

message(STATUS "Embedded ${_name} (${_bytes} bytes, delimiter )${_delim}\") -> ${URDF_OUT}")
